{
  "expo": {
    "name": "نبضة",
    "slug": "viber-tok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yalla-clone",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3FF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nabda.yalla",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "نحتاج إذن الميكروفون للتحدث في الغرف الصوتية."
      }
    },
    "android": {
      "package": "com.nabda.yalla",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {}
      ],
      "expo-font",
      "expo-web-browser",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج إذن الوصول إلى صورك لتغيير صورة ملفك الشخصي."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "wahaj-iraq",
    "extra": {
      "eas": {
        "projectId": "b2229c98-2374-42ca-9d72-54c018d5036a"
      }
    }
  }
}
