# Copy to .env and fill in — .env is git-ignored.
# Postgres connection string (Supabase: Connect → Connection String → Session pooler;
# URL-encode special characters in the password, e.g. $ becomes %24).
DATABASE_URL=
# Clerk keys (clerk.com → your app → API Keys).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated owner emails (full admin access in the app).
ADMIN_EMAILS=
PORT=5000

# --- Image hosting (optional) ---------------------------------------------
# Without these, post images stay inline as data: URIs, which works but bloats
# the database. Supabase → Project Settings → API.
# SUPABASE_URL is the Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# The service_role key — server-side only, never ship it to the app.
SUPABASE_SERVICE_KEY=
# Storage bucket name; create it as a PUBLIC bucket. Defaults to "media".
SUPABASE_BUCKET=media

# --- Voice (optional) ------------------------------------------------------
# Without these, mic seats sync but carry no audio. agora.io → your project.
# The certificate signs tokens and must never reach the client.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
